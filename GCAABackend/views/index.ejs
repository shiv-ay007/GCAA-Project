<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GCAAA Backend API • Status & Documentation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-gradient: radial-gradient(circle at top center, #1e1b4b 0%, #0f172a 45%, #020617 100%);
      --card-bg: rgba(30, 41, 59, 0.7);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-hover-border: rgba(99, 102, 241, 0.4);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --emerald: #10b981;
      --emerald-glow: rgba(16, 185, 129, 0.25);
      --indigo: #6366f1;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      background: var(--bg-gradient);
      color: var(--text-main);
      font-family: var(--font-sans);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2.5rem 1.25rem 4rem;
      overflow-x: hidden;
    }

    .container {
      width: 100%;
      max-width: 980px;
      margin: 0 auto;
    }

    /* Header */
    .header {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 1rem;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.35);
      border-radius: 9999px;
      color: #34d399;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      margin-bottom: 1.25rem;
      box-shadow: 0 0 20px var(--emerald-glow);
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background-color: var(--emerald);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--emerald);
      animation: pulse 2s infinite ease-in-out;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.3); }
    }

    .title {
      font-size: 2.35rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.2;
      background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 50%, #94a3b8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 0.5rem;
    }

    .subtitle {
      font-size: 1.05rem;
      color: var(--text-muted);
      max-width: 620px;
      margin: 0 auto;
    }

    /* Metrics Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2.5rem;
    }

    .metric-card {
      background: var(--card-bg);
      backdrop-filter: blur(12px);
      border: 1px solid var(--card-border);
      border-radius: 1rem;
      padding: 1.25rem;
      transition: all 0.2s ease;
    }

    .metric-card:hover {
      border-color: var(--card-hover-border);
      transform: translateY(-2px);
    }

    .metric-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
      font-weight: 600;
    }

    .metric-value {
      font-size: 1.25rem;
      font-weight: 700;
      color: #f1f5f9;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .metric-value.mono {
      font-family: var(--font-mono);
      font-size: 1.05rem;
    }

    .text-emerald { color: #34d399; }
    .text-indigo { color: #818cf8; }

    /* Endpoints Section */
    .section-title {
      font-size: 1.35rem;
      font-weight: 700;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #e2e8f0;
    }

    .endpoints-list {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-bottom: 2.5rem;
    }

    .endpoint-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      background: var(--card-bg);
      backdrop-filter: blur(12px);
      border: 1px solid var(--card-border);
      border-radius: 0.85rem;
      padding: 0.95rem 1.25rem;
      text-decoration: none;
      color: inherit;
      transition: all 0.2s ease;
    }

    .endpoint-item:hover {
      border-color: var(--card-hover-border);
      background: rgba(30, 41, 59, 0.95);
      transform: translateX(4px);
    }

    .endpoint-left {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      flex-wrap: wrap;
    }

    .method-badge {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.6rem;
      border-radius: 0.35rem;
      letter-spacing: 0.05em;
    }

    .method-get {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .method-post {
      background: rgba(99, 102, 241, 0.15);
      color: #a5b4fc;
      border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .endpoint-path {
      font-family: var(--font-mono);
      font-size: 0.92rem;
      color: #f1f5f9;
      font-weight: 500;
    }

    .endpoint-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .arrow-icon {
      color: #64748b;
      font-size: 1.1rem;
      transition: transform 0.2s ease;
    }

    .endpoint-item:hover .arrow-icon {
      color: #a5b4fc;
      transform: translateX(3px);
    }

    /* Links Footer */
    .links-footer {
      display: flex;
      justify-content: center;
      gap: 1.25rem;
      flex-wrap: wrap;
      padding-top: 1.5rem;
      border-top: 1px solid var(--card-border);
    }

    .portal-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      border-radius: 0.65rem;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .portal-btn.primary {
      background: #4f46e5;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
    }

    .portal-btn.primary:hover {
      background: #4338ca;
      transform: translateY(-1px);
    }

    .portal-btn.secondary {
      background: rgba(255, 255, 255, 0.05);
      color: #cbd5e1;
      border: 1px solid var(--card-border);
    }

    .portal-btn.secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #ffffff;
    }

    .copyright {
      text-align: center;
      font-size: 0.8rem;
      color: #64748b;
      margin-top: 1.5rem;
    }

    @media (max-width: 640px) {
      .title { font-size: 1.75rem; }
      .metrics-grid { grid-template-columns: 1fr 1fr; }
      .endpoint-item { flex-direction: column; align-items: flex-start; }
      .arrow-icon { display: none; }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <div class="badge-status">
        <span class="pulse-dot"></span>
        API Engine Active & Live
      </div>
      <h1 class="title">GCAAA Backend API</h1>
      <p class="subtitle">
        Govt. College of Architecture Alumni Association • Central REST API, Membership Database & Election Registry Engine
      </p>
    </header>

    <!-- Metrics Cards -->
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-label">Status</div>
        <div class="metric-value text-emerald">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
          <%= status || 'Healthy' %>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Database</div>
        <div class="metric-value text-indigo">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
          <%= dbStatus || 'Connected' %>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Server Uptime</div>
        <div class="metric-value mono">
          <%= uptime %>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Environment</div>
        <div class="metric-value mono" style="font-size: 0.95rem;">
          <%= environment || 'production' %>
        </div>
      </div>
    </div>

    <!-- API Endpoints -->
    <h2 class="section-title">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
      Key API Endpoints
    </h2>

    <div class="endpoints-list">
      <a href="/api/registered-members" class="endpoint-item" target="_blank">
        <div class="endpoint-left">
          <span class="method-badge method-get">GET</span>
          <span class="endpoint-path">/api/registered-members</span>
          <span class="endpoint-desc">— Query life members with pagination & search</span>
        </div>
        <span class="arrow-icon">→</span>
      </a>

      <a href="/api/registered-members/stats" class="endpoint-item" target="_blank">
        <div class="endpoint-left">
          <span class="method-badge method-get">GET</span>
          <span class="endpoint-path">/api/registered-members/stats</span>
          <span class="endpoint-desc">— Member distribution & cohort metrics</span>
        </div>
        <span class="arrow-icon">→</span>
      </a>

      <a href="/api/batch-alumni" class="endpoint-item" target="_blank">
        <div class="endpoint-left">
          <span class="method-badge method-get">GET</span>
          <span class="endpoint-path">/api/batch-alumni</span>
          <span class="endpoint-desc">— 1985–2025 Architecture graduation archives</span>
        </div>
        <span class="arrow-icon">→</span>
      </a>

      <a href="/api/batch-alumni/stats" class="endpoint-item" target="_blank">
        <div class="endpoint-left">
          <span class="method-badge method-get">GET</span>
          <span class="endpoint-path">/api/batch-alumni/stats</span>
          <span class="endpoint-desc">— Batch totals, payment statuses & metrics</span>
        </div>
        <span class="arrow-icon">→</span>
      </a>

      <a href="/api/election-nominations" class="endpoint-item" target="_blank">
        <div class="endpoint-left">
          <span class="method-badge method-get">GET</span>
          <span class="endpoint-path">/api/election-nominations</span>
          <span class="endpoint-desc">— Biennial 2026–2028 election nomination list</span>
        </div>
        <span class="arrow-icon">→</span>
      </a>

      <div class="endpoint-item" style="cursor: default;">
        <div class="endpoint-left">
          <span class="method-badge method-post">POST</span>
          <span class="endpoint-path">/api/admin/auth/login</span>
          <span class="endpoint-desc">— Administrator secure JWT sign-in</span>
        </div>
        <span style="font-size: 0.75rem; color: #64748b; font-family: var(--font-mono);">BEARER JWT</span>
      </div>

      <a href="/api/health" class="endpoint-item" target="_blank">
        <div class="endpoint-left">
          <span class="method-badge method-get">GET</span>
          <span class="endpoint-path">/api/health</span>
          <span class="endpoint-desc">— System health ping & JSON monitor</span>
        </div>
        <span class="arrow-icon">→</span>
      </a>
    </div>

    <!-- Quick Navigation Links -->
    <div class="links-footer">
      <a href="https://gcaalumniassociation.com" class="portal-btn primary" target="_blank">
        Open Main Portal ↗
      </a>
      <a href="https://admin.gcaalumniassociation.com" class="portal-btn secondary" target="_blank">
        Admin Dashboard ↗
      </a>
    </div>

    <div class="copyright">
      &copy; <%= new Date().getFullYear() %> Govt. College of Architecture Alumni Association. All rights reserved.
    </div>
  </div>
</body>
</html>
